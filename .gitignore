# Kormo Root .gitignore

# Environment & Secrets (NEVER commit secrets)
.env
.env.local
.env.*.local
*.env
!.env.example

# Flutter & Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub/
app/.pub-cache/
app/build/
**/build/
.dart_tool/

# Android
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
*.apk
*.aab

# OS & IDE
.DS_Store
Thumbs.db
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.log
